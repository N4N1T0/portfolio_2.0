---
import { Image } from 'astro:assets'
import { USER_DATA } from '@/constants/site-data'
import { getLangFromLocale } from '@/i18n/utils'

// I18N
const lang = getLangFromLocale(Astro.currentLocale)
---

<div class='screen-line-after flex border-x border-edge max-container'>
  <div class='flex-1'>
    <div class='sm:border-t border-edge'>
      <h1 class='flex items-center pl-4 text-3xl font-semibold'>
        {USER_DATA.displayName}
      </h1>

      <div
        class='h-16 border-t border-edge py-1 pl-4 sm:h-auto overflow-hidden'
      >
        <span
          class='text-sm text-balance text-muted-foreground select-none h-fit flex flex-col justify-center my-auto'
        >
          {USER_DATA.sentences[lang]}
        </span>
      </div>
    </div>
  </div>
</div>
