---
import { getLangFromLocale } from '@/i18n/utils'

// TYPES
interface Props {
  item: {
    content?: string | Record<'en' | 'es', string>
    href?: string
    icon: string
  }
}

// PROPS
const { content, href } = Astro.props.item

// I18N
const lang = getLangFromLocale(Astro.currentLocale)

// CONST
const formattedContent = typeof content === 'object' ? content[lang] : content
---

<div class='flex items-center gap-4 text-sm'>
  <div
    class='flex size-7 shrink-0 items-center justify-center bg-muted rounded-sm'
    aria-hidden='true'
  >
    <div
      class='size-6 border-[0.2px] flex justify-center items-center border-muted-foreground/50 rounded-sm'
    >
      <slot />
    </div>
  </div>

  <p class='text-balance'>
    {
      Astro.slots.has('content') ? (
        <slot name='content' />
      ) : href ? (
        <a
          class='underline-offset-4 link-underline'
          href={href}
          target='_blank'
          rel='noopener noreferrer'
        >
          {formattedContent}
        </a>
      ) : (
        formattedContent
      )
    }
  </p>
</div>
