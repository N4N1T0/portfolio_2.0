---
import { Note, NoteArrow } from '@/components/ui/floating-notes'
import {
  Tooltip,
  TooltipContent,
  TooltipTrigger
} from '@/components/ui/tooltip'
import { TECH_STACK } from '@/constants/site-data'
import { Image } from 'astro:assets'
---

<section id='techstack' class='section max-container relative'>
  <div
    class='[--pattern-foreground:var(--color-zinc-950)]/5 dark:[--pattern-foreground:var(--color-white)]/5 bg-[radial-gradient(var(--pattern-foreground)_1px,transparent_0)] bg-size-[10px_10px] bg-center bg-zinc-950/0.75 dark:bg-white/0.75 px-5 py-10'
  >
    <ul class='flex flex-wrap gap-5 select-none'>
      {
        TECH_STACK.map(({ href, title, key }: (typeof TECH_STACK)[0]) => {
          return (
            <li class='flex'>
              <Tooltip>
                <TooltipTrigger>
                  <a
                    href={href}
                    target='_blank'
                    rel='noopener noreferrer'
                    aria-label={title}
                  >
                    <Image
                      src={`https://cdn.simpleicons.org/${key}`}
                      alt={`${title} icon`}
                      width={46}
                      height={46}
                    />
                    <span class='sr-only'>{title}</span>
                  </a>
                </TooltipTrigger>
                <TooltipContent>
                  <span>{title}</span>
                </TooltipContent>
              </Tooltip>
            </li>
          )
        })
      }
    </ul>
  </div>
  <div
    class='top-2 left-1/2 translate-x-96 ml-2 absolute md:flex gap-2 items-start hidden'
  >
    <NoteArrow class='size-4 text-foreground -rotate-36' />
    <Note text='and a few more' />
  </div>
</section>
