---
import { cn } from '@/lib/utils'

interface Props {
  label: string
  className?: string
}

const { label, className } = Astro.props
---

<div
  class={cn('flex min-w-0 flex-col gap-1 bg-background px-4 py-3', className)}
>
  <dt
    class='text-micro/4 font-medium tracking-wider text-muted-foreground uppercase'
  >
    {label}
  </dt>
  <dd class='text-sm'>
    <slot />
  </dd>
</div>
