---
import { getLangFromLocale } from '@/i18n/utils'
import Field from './FooterField.astro'
import { getSnippetCounts } from '@/lib/fetchers'
import { Icons } from '@/components/icons/icons'
import { USER_DATA } from '@/constants/site-data'
import { getRelativeLocaleUrl } from 'astro:i18n'

// I18N
const lang = getLangFromLocale(Astro.currentLocale)

// CONST
const year = new Date().getFullYear()
const date =
  lang === 'en'
    ? new Date().toLocaleDateString('en-US', { dateStyle: 'short' })
    : new Date().toLocaleDateString('es-ES', { dateStyle: 'short' })

const snippetsCounts = await getSnippetCounts(lang)
const linkedIn = USER_DATA.social.find((social) => social.icon === 'linkedIn')

const stack = ['astro@7.3.2', 'tailwindcss@4.3.3', 'preact@10.29.8']
const analytics = ['Vercel Analytics', 'Google Analytics']
---

<footer class='max-w-screen overflow-x-clip px-2 screen-line-before'>
  <div
    class='mx-auto border-x border-edge group-has-data-[slot=layout-wide]/layout:container md:max-w-3xl'
  >
    <div class='relative'>
      <div
        class='screen-line-after flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3 font-mono text-sm'
      >
        <span class='font-bold font-pixel text-xl'>AAA</span>
        <span class='font-sans text-muted-foreground'>
          © {year} Adrián Álvarez. All rights reserved.
        </span>
      </div>

      <dl class='grid grid-cols-2 gap-px bg-edge font-mono md:grid-cols-4'>
        <Field label='Crafted by'>
          <a
            class='link-underline'
            href={linkedIn?.href}
            target='_blank'
            rel='noopener noreferrer'
          >
            @adrian
          </a>
        </Field>

        <Field label='Build'>
          <span class='text-muted-foreground'>static build</span>
        </Field>

        <Field label='Date'>
          <time datetime={date}>{date}</time>
        </Field>

        <Field label='Registry'>{snippetsCounts} snippets</Field>

        <Field label='Deployed on'>
          <span class='font-sans' aria-hidden> ▲ </span>
          <span>Vercel</span>
        </Field>

        <Field label='Source code'>
          <a
            class='link-underline'
            href='https://github.com/N4N1T0/portfolio_2.0'
            target='_blank'
            rel='noopener noreferrer'
          >
            GitHub
          </a>
        </Field>

        <Field label='License'>
          <a
            class='link-underline'
            href='https://github.com/N4N1T0/portfolio_2.0'
            target='_blank'
            rel='noopener noreferrer'
          >
            MIT License
          </a>
        </Field>

        <Field label='Typeface'>
          <a
            class='link-underline'
            href='https://vercel.com/blog/introducing-geist-pixel'
            target='_blank'
            rel='noopener noreferrer'
          >
            Geist Pixel
          </a></Field
        >

        <Field className='col-span-2' label='Stack'>
          <ul class='flex flex-col gap-0.5'>
            {stack.map((entry) => <li>{entry}</li>)}
          </ul>
        </Field>

        <Field className='col-span-2' label='Analytics'>
          <ul class='flex flex-col gap-0.5'>
            {analytics.map((entry) => <li>{entry}</li>)}
          </ul>
        </Field>
      </dl>
    </div>

    <div class='screen-line-after screen-line-before h-4'></div>

    <div
      class='flex items-center gap-3 px-4 py-3 text-muted-foreground screen-line-after'
    >
      <a
        href={getRelativeLocaleUrl(lang, '/')}
        class='mr-auto text-muted-foreground transition-[color] hover:text-foreground'
        aria-label='Home'
      >
        AAA
      </a>

      <div class='divide-x flex items-center gap-3'>
        <a
          class='flex items-center pr-4 transition-[color] hover:text-foreground'
          href={linkedIn?.href}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='LinkedIn Profile'
        >
          <Icons.linkedIn class='size-5' />
        </a>
        <a
          class='flex items-center transition-[color] hover:text-foreground'
          href='https://www.dmca.com/ProtectionPro.aspx'
          target='_blank'
          rel='noopener noreferrer'
          aria-label='DMCA.com Protection Status'
        >
          <Icons.dmca class='w-12 h-5' />
        </a>
      </div>
    </div>
  </div>

  <h2
    class='mx-auto mb-[-2vw] w-fit text-[16vw] leading-none font-black tracking-tighter uppercase font-pixel text-muted-foreground opacity-10 transition-opacity duration-500 ease-in-out select-none hover:opacity-100 md:text-[12vw]'
    aria-hidden='true'
  >
    AAA / N-9
  </h2>

  <div
    class='h-20 screen-line-before border-t-[0.5px] border-edge bg-background'
  >
  </div>
</footer>
