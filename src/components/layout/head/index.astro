---
import { changeLangFromUrl } from '@/i18n/utils'

interface Props {
  title?: string | undefined
  description?: string | undefined
  image?: ImageMetadata
  ld?: string
  lang: string | undefined
  noindex?: boolean
  type?: 'website' | 'article'
  counterpartId?: string
}

const {
  title,
  description,
  image,
  ld,
  lang,
  noindex = false,
  type = 'website',
  counterpartId
} = Astro.props

const locale = lang === 'en' ? 'en' : 'es'
const alternateLocale = locale === 'es' ? 'en' : 'es'

const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const alternateUrl = new URL(
  new URL(
    changeLangFromUrl(Astro.url, locale, counterpartId)
  ).pathname,
  Astro.site
).toString()
const defaultUrl = locale === 'es' ? canonical : alternateUrl

const ogImage = image?.src
  ? new URL(image.src, Astro.site).toString()
  : new URL(`/${locale}/og-image.png`, Astro.site).toString()

const siteName = 'Adrian Alvarez'
const robots = noindex ? 'noindex, follow' : 'index, follow'
---

<head>
  <!-- Basic HTML Meta Tags -->
  <meta charset='utf-8' />
  <meta name='robots' content={robots} />
  <meta name='googlebot' content={robots} />
  <meta name='viewport' content='width=device-width, initial-scale=1' />
  <meta name='generator' content={Astro.generator} />
  <meta name='subject' content='Adrian Alvarez Alonso Portfolio' />
  <meta name='language' content={locale.toUpperCase()} />
  <meta
    name='author'
    content="Adrian 'Nano' Alvarez, adrian.alvarezalonso1991@gmail.com"
  />
  <link rel='canonical' href={canonical} />
  <meta name='description' content={description} />
  <link rel='sitemap' href={new URL('sitemap-index.xml', Astro.site)} />
  <title>{title}</title>

  <!-- Language -->
  <link rel='alternate' href={canonical} hreflang={locale} />
  <link rel='alternate' href={alternateUrl} hreflang={alternateLocale} />
  <link rel='alternate' href={defaultUrl} hreflang='x-default' />

  <!-- Favicon -->
  <link
    rel='apple-touch-icon-precomposed'
    href={new URL('apple-touch-icon.png', Astro.site)}
  />
  <link rel='shortcut icon' type='image/x-icon' href='/favicon.ico' />

  <!-- Open Graph -->
  <meta property='og:type' content={type} />
  <meta property='og:site_name' content={siteName} />
  <meta property='og:locale' content={locale === 'es' ? 'es_ES' : 'en_US'} />
  <meta
    property='og:locale:alternate'
    content={alternateLocale === 'es' ? 'es_ES' : 'en_US'}
  />
  <meta property='og:url' content={canonical} />
  <meta property='og:title' content={title} />
  <meta property='og:description' content={description} />
  <meta property='og:image' content={ogImage} />

  <!-- Twitter -->
  <meta property='twitter:card' content='summary_large_image' />
  <meta property='twitter:site' content='@AdrianlvarezAl1' />
  <meta property='twitter:creator' content='@AdrianlvarezAl1' />
  <meta property='twitter:url' content={canonical} />
  <meta property='twitter:title' content={title} />
  <meta property='twitter:description' content={description} />
  <meta property='twitter:image' content={ogImage} />

  <!-- Rss Feed -->
  <link
    rel='alternate'
    type='application/rss+xml'
    title='Adrian Alvarez — RSS'
    href='/rss.xml'
  />

  <!-- Schema -->
  {
    ld && (
      <Fragment
        set:html={`<script type='application/ld+json'>${ld}</script>`}
      />
    )
  }

  <!-- Google tag (gtag.js) -->
  <script
    async
    is:inline
    src='https://www.googletagmanager.com/gtag/js?id=G-BH16G0HVKV'></script>
  <script type='text/partytown' is:inline>
    window.dataLayer = window.dataLayer || []
    function gtag() {
      dataLayer.push(arguments)
    }
    gtag('js', new Date())

    gtag('config', 'G-BH16G0HVKV')
  </script>
</head>
