---
import { cn } from '@/lib/utils'
import { NAVIGATION_ITEMS } from '@/constants/site-data'
import { getLangFromLocale } from '@/i18n/utils'
import { getRelativeLocaleUrl } from 'astro:i18n'

// CONST
const active = Astro.url.pathname
const lang = getLangFromLocale(Astro.currentLocale)
---

<nav class='md:flex items-center gap-4 hidden z-100'>
  {
    NAVIGATION_ITEMS.map(({ title, href }) => {
      const isActive =
        href === '/'
          ? active === '/es/' || active === '/en/'
          : active === `/${lang}${href}` ||
            (href !== '/' && active.includes(href))
      return (
        <a
          class={cn(
            'text-sm font-medium text-muted-foreground transition-colors ease-in duration-200 hover:text-foreground',
            isActive && 'text-foreground underline underline-offset-4'
          )}
          href={getRelativeLocaleUrl(lang, href)}
          aria-current={isActive ? 'page' : undefined}
        >
          {title[lang]}
        </a>
      )
    })
  }
</nav>
