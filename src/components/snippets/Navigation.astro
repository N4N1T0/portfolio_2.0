---
import { getSnippets } from '@/lib/fetchers'
import { Icons } from '@/components/icons/icons'
import { buttonVariants } from '@/components/ui/utils'
import { getLangFromLocale, useTranslations } from '@/i18n/utils'
import { getRelativeLocaleUrl } from 'astro:i18n'
import SharePage from '@/components/shared/SharePage.astro'

// TYPES
interface Props {
  snippetId: string
}

// PROPS
const { snippetId } = Astro.props

// I18N
const lang = getLangFromLocale(Astro.currentLocale)
const t = useTranslations(lang)

// FETCHERS
const snippets = await getSnippets(lang).then((snippets) => {
  return snippets.filter((snippet) => !snippet.data.comingSoon)
})

const actualSnippet = snippets.findIndex((snippet) => snippet.id === snippetId)

// CONSTS
const previous = actualSnippet > 0 ? snippets[actualSnippet - 1] : null
const next =
  actualSnippet < snippets.length - 1 ? snippets[actualSnippet + 1] : null
---

<nav
  class='flex items-center justify-between px-2 py-3 max-container border-x border-edge screen-line-after'
>
  <a
    href={getRelativeLocaleUrl(lang, '/projects')}
    class={buttonVariants({ variant: 'link' })}
  >
    <Icons.arrowLeft />
    {t('snippets').title}
  </a>

  <div class='flex items-center gap-2'>
    <SharePage />

    {
      previous && (
        <a
          href={getRelativeLocaleUrl(lang, `/projects${previous.id}`)}
          class={buttonVariants({
            variant: 'outline',
            size: 'icon',
            className: 'hover:bg-muted'
          })}
        >
          <Icons.arrowLeft />
          <span class='sr-only'>Previous</span>
        </a>
      )
    }

    {
      next && (
        <a
          href={getRelativeLocaleUrl(lang, `/projects${next.id}`)}
          class={buttonVariants({
            variant: 'outline',
            size: 'icon',
            className: 'hover:bg-muted'
          })}
        >
          <span class='sr-only'>Next</span>
          <Icons.arrowLeft class='rotate-180' />
        </a>
      )
    }
  </div>
</nav>
