---
import type { HTMLAttributes } from 'astro/types'
import { tv } from 'tailwind-variants'
import type { ContributionGraph } from './graph'

type Props = HTMLAttributes<'div'> & {
  /**
   * The computed graph, from `buildContributionGraph()`. It replaces the
   * Preact version's context: every part reads the same object.
   */
  graph: ContributionGraph
}

const contributionGraph = tv({
  base: 'flex w-max max-w-full flex-col gap-2'
})

const { graph, class: className, ...rest } = Astro.props
---

{
  !graph.isEmpty && (
    <div
      class={contributionGraph({ class: className })}
      style={{ fontSize: `${graph.fontSize}px` }}
      {...rest}
    >
      <slot />
    </div>
  )
}
