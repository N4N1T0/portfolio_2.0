---
import type { HTMLAttributes } from 'astro/types'
import { tv } from 'tailwind-variants'
import type { ContributionGraph } from './graph'
import { formatTotalCount } from './graph'

type Props = HTMLAttributes<'div'> & {
  graph: ContributionGraph
}

const contributionGraphTotalCount = tv({ base: 'text-muted-foreground' })

const { graph, class: className, ...rest } = Astro.props
---

<slot>
  <div class={contributionGraphTotalCount({ class: className })} {...rest}>
    {formatTotalCount(graph)}
  </div>
</slot>
