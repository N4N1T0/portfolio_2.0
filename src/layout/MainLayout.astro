---
import Header from '@/components/layout/header/index.astro'
import Footer from '@/components/layout/footer/index.astro'
import Head from '@/components/layout/head/index.astro'

import '@/styles/global.css'

// TYPES
interface Props {
  title?: string | undefined
  description?: string | undefined
  image?: ImageMetadata
  ld?: string
  noindex?: boolean
  type?: 'website' | 'article'
  counterpartId?: string
}

// PROPS
const {
  title = 'Adrian Alvarez Portfolio',
  description = 'Adrian Alvarez, fullstack engineer. APIs, interfaces and data systems in production.',
  image,
  ld,
  noindex = false,
  type = 'website',
  counterpartId
} = Astro.props

// I18N
const lang = Astro.currentLocale
const skipLabel =
  lang === 'en' ? 'Skip to main content' : 'Saltar al contenido principal'
---

<!doctype html>
<html lang={lang}>
  <Head
    title={title}
    description={description}
    lang={lang}
    image={image}
    ld={ld}
    noindex={noindex}
    type={type}
    counterpartId={counterpartId}
  />
  <body class='relative antialiased'>
    <a
      href='#main'
      class='sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-foreground focus:outline-2 focus:outline-ring'
    >
      {skipLabel}
    </a>
    <Header />
    <main
      id='main'
      class='max-w-screen overflow-x-hidden px-2 mt-12'
      tabindex='-1'
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
