---
import Header from '@/components/layout/header/index.astro'
import Footer from '@/components/layout/footer/index.astro'
import Head from '@/components/layout/head/index.astro'

import '@/styles/global.css'

// TYPES
interface Props {
  title?: string | undefined
  description?: string | undefined
  image?: ImageMetadata
  ld?: string
}

// PROPS
const {
  title = 'Default Title',
  description = 'Default description for the website',
  image,
  ld = 'summary_large_image'
} = Astro.props

// I18N
const lang = Astro.currentLocale
---

<!doctype html>
<html lang={lang}>
  <Head
    title={title}
    description={description}
    lang={lang}
    image={image}
    ld={ld}
  />
  <body class='relative antialiased'>
    <Header />
    <main class='max-w-screen overflow-x-hidden px-2 mt-12'>
      <slot />
    </main>
    <Footer />
    <div class='pointer-events-none fixed inset-x-0 bottom-0 z-50' aria-hidden>
      <div
        class='h-20 bg-linear-to-b from-transparent to-background mask-linear-[to_top,var(--background)_25%,transparent] backdrop-blur-[1px]'
      >
      </div>
      <div class='bg-background pb-[env(safe-area-inset-bottom,0)]'></div>
    </div>
  </body>
</html>
