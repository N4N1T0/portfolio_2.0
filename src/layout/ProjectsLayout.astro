---
import Navigation from '@/components/projects/Navigation.astro'
import MainLayout from './MainLayout.astro'
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { cn } from '@/lib/utils'
import Separator from '@/components/shared/Separator.astro'

interface Props {
  project: CollectionEntry<'projects'>
  ld: string
}

const { ld, project } = Astro.props
const {
  id,
  data: { images, title, excerpt }
} = project
---

<MainLayout title={title} description={excerpt} image={images[0].src} ld={ld}>
  <Separator className='screen-line-after' />
  <Navigation projectId={id} />
  <Separator />

  <section class='screen-line-before group max-container'>
    <div class='size-full overflow-hidden relative'>
      {
        images.map(({ alt, src }, index) => (
          <Image
            src={src as ImageMetadata}
            alt={alt}
            width={1200}
            height={630}
            quality={100}
            priority
            class={cn(
              'size-full object-cover absolute inset-0',
              index === 0 ? 'opacity-100' : 'opacity-0'
            )}
          />
        ))
      }
    </div>
  </section>
  <section class='section px-4 max-container'>
    <slot />
  </section>
</MainLayout>
