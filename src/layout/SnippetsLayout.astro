---
import type { CollectionEntry } from 'astro:content'
import MainLayout from './MainLayout.astro'
import Separator from '@/components/shared/Separator.astro'
import Navigation from '@/components/snippets/Navigation.astro'

interface Props {
  snippet: CollectionEntry<'snippets'>
  ld: string
  type?: 'website' | 'article'
  counterpartId?: string
}

const { snippet, ld, type = 'website', counterpartId } = Astro.props
const {
  id,
  data: { title, excerpt }
} = snippet
---

<MainLayout title={title} description={excerpt} ld={ld} type={type} counterpartId={counterpartId}>
  <Separator className='screen-line-after' />
  <Navigation snippetId={id} />
  <Separator />
  <section class='section px-4 max-container pt-3'>
    <slot />
  </section>
</MainLayout>
