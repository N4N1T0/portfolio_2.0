---
import Hero from '@/components/home/hero/index.astro'
import About from '@/components/home/about/index.astro'
import Overview from '@/components/home/overview/index.astro'
import SocialLinks from '@/components/home/social-links/index.astro'
import Separator from '@/components/shared/Separator.astro'
import MainLayout from '@/layout/MainLayout.astro'
import TechStack from '@/components/home/techstack/index.astro'
import BlogList from '@/components/blog/blog-list/index.astro'
import Experience from '@/components/home/experiences/index.astro'
import Projects from '@/components/projects/index.astro'
import Certifications from '@/components/home/certifications/index.astro'
import GithubContributions from '@/components/home/github-contributions/index.astro'
import { Note, NoteArrow } from '@/components/ui/floating-notes'
---

<MainLayout
  description='Senior Full-stack developer with a frontend heart and a strong focus on performance, CRO, and user-centered design. I specialize in building fast, accessible, conversion-driven websites and SaaS platforms using React, Next.js, Astro, and Sanity.'
  title='Adrian Alvarez Portfolio'
>
  <Hero />
  <Separator />
  <Overview />
  <Separator />
  <GithubContributions />
  <Separator />
  <SocialLinks />
  <Separator />
  <About />
  <Separator />
  <TechStack />
  <Separator />
  <BlogList />
  <Separator />
  <Experience />
  <Separator />
  <Projects>
    <div
      class='bottom-1/6 right-1/2 -translate-x-96 mr-2 absolute md:flex gap-2 items-start hidden'
    >
      <Note text='a few more coming soon' />
      <NoteArrow class='size-4 text-foreground rotate-132' />
    </div>
  </Projects>
  <Separator />
  <Certifications />
  <Separator className='screen-line-after' />
</MainLayout>
