---
import MainLayout from '@/layout/MainLayout.astro'
import BlogList from '@/components/blog/blog-list/index.astro'
import Separator from '@/components/shared/Separator.astro'
import { useTranslations } from '@/i18n/utils'
import { getPosts } from '@/lib/fetchers'
import { generateBlogListJsonLD } from '@/components/layout/head/jsonLD'

// I18N
const t = useTranslations('es')

// SEO
const blogPosts = await getPosts('es')
const ld = generateBlogListJsonLD(blogPosts, 'es')
---

<MainLayout
  description='Artículos sobre desarrollo fullstack, APIs, datos, rendimiento y producto. Experiencias y decisiones técnicas explicadas sin humo.'
  title='Blog — Adrián Álvarez'
  ld={ld}
>
  <Separator />
  <BlogList showAll={true} priority={true} subtitle={t('blogList').subtitle} />
  <Separator />
</MainLayout>
